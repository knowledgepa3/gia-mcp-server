{
  "name": "gia-mcp-server",
  "version": "0.4.3",
  "description": "Runtime governance layer for AI agents. Model-agnostic and vendor-neutral — works with any MCP-compatible client, agent, or framework. MAI decision classification, human-in-the-loop gates, hash-chained forensic audit, governed context authority, EU AI Act / NIST / SOC 2 / CMMC mapping.",
  "homepage": "https://gia.aceadvising.com/get-api-key",
  "author": {
    "name": "William J. Storey III",
    "url": "https://aceadvising.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gia-mcp-server": "bin/gia-mcp-server.js"
  },
  "files": [
    "dist/",
    "bin/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-governance",
    "governance",
    "agent-governance",
    "audit",
    "forensic-ledger",
    "compliance",
    "human-in-the-loop",
    "ai-safety",
    "guardrails",
    "policy-enforcement",
    "ai-contract",
    "nist",
    "eu-ai-act",
    "iso-42001",
    "soc2",
    "cmmc",
    "fedramp",
    "sdvosb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/knowledgepa3/gia-mcp-server"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/mcp/server.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/mcp/server-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:governance": "vitest run tests/core/",
    "test:integration": "vitest run tests/integration/",
    "test:smoke": "tsx tests/smoke/live-server.ts",
    "lint": "eslint src/",
    "onboard": "tsx src/onboarding/generate-client-config.ts",
    "prepublishOnly": "npm run build && npm run test:release",
    "test:release": "vitest run tests/shared/version-provenance.test.ts tests/docs/published-claims.test.ts tests/mcp/tool-classification-drift.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ioredis": "^5.10.1",
    "pg": "^8.13.0",
    "uuid": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "vite": "^7.3.5",
    "esbuild": "^0.28.1"
  }
}
